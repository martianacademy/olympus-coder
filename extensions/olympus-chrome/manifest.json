{
  "manifest_version": 3,
  "name": "Olympus Coder Browser",
  "version": "0.2.0",
  "key": "",
  "description": "Auto-connects your real Chrome browser to Olympus Coder agents with live visual cursor, smooth scrolling, and CDP debugging.",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Olympus Coder Browser",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
