{
  "manifest_version": 3,
  "name": "Olympus Coder Browser",
  "version": "0.3.0",
  "description": "Lets your Olympus Coder AI agents see and use your Chrome, with a live cursor and a Stop button. Talks only to the app on your PC.",
  "key": "",
  "minimum_chrome_version": "116",
  "homepage_url": "https://olympus.marsnext.in",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Olympus Coder Browser",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "stop-agent": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Stop the AI agent using this browser"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
